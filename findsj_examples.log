*! version 2.3  2025/05/08

.
. * Verify that an author command returns exactly the records whose author field
. * contains every query term as a complete name token.
. capture program drop verify_author_count

. program define verify_author_count
  1.     version 16
  2.     syntax, Query(string) Returned(integer) Datafile(string)
  3.
.     preserve
  4.     quietly use `"`datafile'"', clear
  5.     capture confirm variable authors
  6.     if !_rc rename authors author
  7.
.     tempvar author_tokens matched
  8.     quietly gen strL `author_tokens' = ustrlower(author)
  9.     quietly replace `author_tokens' =         ustrregexra(`author_tokens',
> "[^\p{L}\p{N}_]+", " ")
 10.     quietly replace `author_tokens' =         " " + strtrim(stritrim(`autho
> r_tokens')) + " "
 11.
.     local query_clean =         ustrlower(ustrregexra(`"`query'"', "[^\p{L}\p{
> N}_]+", " "))
 12.     local query_clean = strtrim(stritrim(`"`query_clean'"'))
 13.     local n_words = wordcount(`"`query_clean'"')
 14.
.     quietly gen byte `matched' = 1
 15.     forvalues i = 1/`n_words' {
 16.         local query_word = word(`"`query_clean'"', `i')
 17.         quietly replace `matched' = 0 if             strpos(`author_tokens'
> , " `query_word' ") == 0
 18.     }
 19.
.     quietly count if `matched'
 20.     local expected = r(N)
 21.     restore
 22.
.     if `returned' != `expected' {
 23.         display as error "Author-search regression test failed for: `query'
> "
 24.         display as error "Command returned `returned'; expected `expected'.
> "
 25.         exit 9
 26.     }
 27.     display as result         "PASS: `query' returned all `returned' comple
> te-token matches."
 28. end

.
. * Inspect a batch export as raw text, rather than importing it as delimited
. * data. This catches unwanted CSV quoting and format-specific escaping errors.
. capture program drop verify_export_file

. program define verify_export_file
  1.     version 16
  2.     syntax using/, Format(string) Expected(integer)         [Firstid(string
> ) Contains(string) Excludes(string)]
  3.
.     local format = lower(`"`format'"')
  4.     if !inlist(`"`format'"', "markdown", "latex", "plain") {
  5.         display as error "Unknown export format in regression test: `format
> '"
  6.         exit 198
  7.     }
  8.
.     tempname export_handle
  9.     capture file open `export_handle' using `"`using'"', read text
 10.     if _rc {
 11.         display as error "Could not open export file: `using'"
 12.         exit _rc
 13.     }
 14.
.     local n_lines 0
 15.     local outer_quotes 0
 16.     local missing_marker 0
 17.     local doubled_href 0
 18.     local unescaped_percent 0
 19.     local first_identity_mismatch 0
 20.     local required_text_found = (`"`contains'"' == "")
 21.     local excluded_text_found 0
 22.
.     file read `export_handle' export_line
 23.     while r(eof) == 0 {
 24.         if strtrim(`"`export_line'"') != "" {
 25.             local n_lines = `n_lines' + 1
 26.
.             if `n_lines' == 1 & `"`firstid'"' != "" {
 27.                 if strpos(`"`export_line'"', `"`firstid'"') == 0 {
 28.                     local first_identity_mismatch 1
 29.                 }
 30.             }
 31.
.             if `"`contains'"' != "" &                strpos(`"`export_line'"',
>  `"`contains'"') > 0 {
 32.                 local required_text_found 1
 33.             }
 34.             if `"`excludes'"' != "" &                strpos(`"`export_line'
> "', `"`excludes'"') > 0 {
 35.                 local excluded_text_found 1
 36.             }
 37.
.             if substr(`"`export_line'"', 1, 1) == char(34) |                su
> bstr(`"`export_line'"', -1, 1) == char(34) {
 38.                 local outer_quotes = `outer_quotes' + 1
 39.             }
 40.
.             if `"`format'"' == "markdown" {
 41.                 if strpos(`"`export_line'"', "[Link](") == 0 {
 42.                     local missing_marker = `missing_marker' + 1
 43.                 }
 44.             }
 45.             else if `"`format'"' == "latex" {
 46.                 if strpos(`"`export_line'"', "\href{") == 0 {
 47.                     local missing_marker = `missing_marker' + 1
 48.                 }
 49.                 if strpos(`"`export_line'"', "\\href{") > 0 {
 50.                     local doubled_href = `doubled_href' + 1
 51.                 }
 52.                 local percent_check =                     subinstr(`"`expor
> t_line'"', "\%", "", .)
 53.                 if strpos(`"`percent_check'"', "%") > 0 {
 54.                     local unescaped_percent = `unescaped_percent' + 1
 55.                 }
 56.             }
 57.             else if `"`format'"' == "plain" {
 58.                 if strpos(`"`export_line'"', "Link: https://") == 0 {
 59.                     local missing_marker = `missing_marker' + 1
 60.                 }
 61.             }
 62.         }
 63.         file read `export_handle' export_line
 64.     }
 65.     file close `export_handle'
 66.
.     if `n_lines' != `expected' {
 67.         display as error             "`format' export contained `n_lines' r
> ecords; expected `expected'."
 68.         exit 9
 69.     }
 70.     if `outer_quotes' {
 71.         display as error             "`format' export wrapped one or more r
> ecords in CSV quotes."
 72.         exit 9
 73.     }
 74.     if `missing_marker' {
 75.         display as error             "`format' export omitted its expected
> link syntax."
 76.         exit 9
 77.     }
 78.     if `doubled_href' {
 79.         display as error             "LaTeX export used a doubled backslash
>  before href."
 80.         exit 9
 81.     }
 82.     if `unescaped_percent' {
 83.         display as error             "LaTeX export contained an unescaped p
> ercent sign."
 84.         exit 9
 85.     }
 86.     if `first_identity_mismatch' {
 87.         display as error             "The first export record did not match
>  returned art_id_1."
 88.         exit 9
 89.     }
 90.     if !`required_text_found' {
 91.         display as error             "`format' export omitted required cita
> tion text: `contains'"
 92.         exit 9
 93.     }
 94.     if `excluded_text_found' {
 95.         display as error             "`format' export retained excluded cit
> ation text: `excludes'"
 96.         exit 9
 97.     }
 98.
.     display as result         "PASS: `format' export has `expected' raw, corre
> ctly formatted records."
 99. end

.
